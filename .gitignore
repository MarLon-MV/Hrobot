# Alleen src/ (en deze .gitignore) staat onder versiebeheer; al het andere blijft lokaal
/*
!/src/
!/.gitignore

# colcon / ROS 2
build/
install/
log/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Geheimen
.env
*.pem
.cache/
*.swp
compile_commands.json
src/sllidar_ros2/
__pycache__/
*.pyc

# Opgeslagen kaarten (alleen de map zelf staat onder versiebeheer)
maps/*
!maps/.gitkeep
