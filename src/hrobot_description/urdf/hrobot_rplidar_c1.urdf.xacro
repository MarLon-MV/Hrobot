<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hrobot_rplidar_c1">

  <!-- sim:=true voegt wielen, zwenkwielen en de Gazebo-plugins (gz-sim, Harmonic) toe: diff drive,
       joint states en de RPLIDAR C1 als gpu_lidar. Met sim:=false (echte robot) bestaat het model
       alleen uit base_link + laser_frame: odom/TF komen van de Create 3 zelf. -->
  <xacro:arg name="sim" default="false"/>

  <!-- Geometrie van de Create 3-basis -->
  <xacro:property name="base_radius" value="0.171"/>
  <xacro:property name="base_height" value="0.072"/>
  <xacro:property name="base_mass" value="2.7"/>

  <!-- Montage-offsets van de RPLIDAR C1 ten opzichte van base_link (aanpasbaar) -->
  <xacro:property name="laser_x" value="0.0"/>
  <xacro:property name="laser_y" value="0.0"/>
  <xacro:property name="laser_z" value="0.12"/>
  <!-- Yaw van laser_frame ten opzichte van base_link (rad). Echte RPLIDAR C1: standaard 0; meet in RViz
       waar de 0-gradenstraal heen wijst en pas dit aan als die niet naar voren wijst. De gesimuleerde
       lidar kijkt al naar voren: sim.launch.py geeft 0 mee. -->
  <xacro:arg name="laser_yaw" default="0.0"/>

  <!-- Aandrijfgeometrie van de Create 3 (alleen in simulatie gebruikt) -->
  <xacro:property name="wheel_radius" value="0.03575"/>
  <xacro:property name="wheel_width" value="0.015"/>
  <xacro:property name="wheel_separation" value="0.233"/>
  <xacro:property name="wheel_mass" value="0.2"/>
  <xacro:property name="caster_radius" value="0.01"/>
  <xacro:property name="caster_x" value="0.125"/>
  <!-- Zwaartepunt naar voren verschoven (iRobot ignition-model: 2,28 cm) zodat de robot waterpas
       blijft met één zwenkwiel vooraan. -->
  <xacro:property name="cog_x" value="0.0228"/>

  <!-- Visuele meshes van iRobotEducation/create3_sim (jazzy, BSD-3, zie meshes/LICENSE.irobot).
       Hun z-offset (0,0392) is relatief aan een base_link die 4,45 mm onder de vloer ligt; hier ligt
       base_link op de vloer (wielas op z = wheel_radius), vandaar 0,0392 - 0,00445. -->
  <xacro:property name="mesh_z" value="0.03475"/>

  <!-- Benadering van de behuizing van de RPLIDAR C1 (ca. 55,6 x 55,6 x 41,3 mm, ~110 g) -->
  <xacro:property name="laser_radius" value="0.0278"/>
  <xacro:property name="laser_height" value="0.0413"/>
  <xacro:property name="laser_mass" value="0.110"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${mesh_z}" rpy="0 0 ${pi / 2}"/>
      <geometry>
        <mesh filename="package://hrobot_description/meshes/body_visual.dae"/>
      </geometry>
    </visual>
    <visual>
      <origin xyz="0 0 ${mesh_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hrobot_description/meshes/bumper_visual.dae"/>
      </geometry>
    </visual>
    <!-- Onderkant 0,025 m omhoog zodat de romp in de simulatie nooit over de vloer sleept. -->
    <collision>
      <origin xyz="0 0 ${(base_height + 0.025) / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height - 0.025}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${cog_x} 0 ${base_height / 2}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="${base_mass * (3 * base_radius * base_radius + base_height * base_height) / 12}"
               ixy="0.0" ixz="0.0"
               iyy="${base_mass * (3 * base_radius * base_radius + base_height * base_height) / 12}"
               iyz="0.0"
               izz="${base_mass * base_radius * base_radius / 2}"/>
    </inertial>
  </link>

  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_height}"/>
      </geometry>
      <material name="rplidar_c1_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${laser_mass}"/>
      <inertia ixx="${laser_mass * (3 * laser_radius * laser_radius + laser_height * laser_height) / 12}"
               ixy="0.0" ixz="0.0"
               iyy="${laser_mass * (3 * laser_radius * laser_radius + laser_height * laser_height) / 12}"
               iyz="0.0"
               izz="${laser_mass * laser_radius * laser_radius / 2}"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 $(arg laser_yaw)"/>
  </joint>

  <xacro:if value="$(arg sim)">

    <xacro:macro name="wheel" params="name y">
      <link name="${name}_wheel">
        <visual>
          <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
          <material name="wheel_dark"><color rgba="0.15 0.15 0.15 1.0"/></material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <inertial>
          <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
          <mass value="${wheel_mass}"/>
          <inertia ixx="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12}"
                   ixy="0.0" ixz="0.0"
                   iyy="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12}"
                   iyz="0.0"
                   izz="${wheel_mass * wheel_radius * wheel_radius / 2}"/>
        </inertial>
      </link>
      <joint name="${name}_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="${name}_wheel"/>
        <origin xyz="0 ${y} ${wheel_radius}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
      </joint>
    </xacro:macro>

    <xacro:wheel name="left" y="${wheel_separation / 2}"/>
    <xacro:wheel name="right" y="${-wheel_separation / 2}"/>

    <!-- Wrijvingsloos kogelwiel alleen vooraan, zoals de echte Create 3 (mu = 0 hieronder). -->
    <xacro:macro name="caster" params="name x">
      <link name="${name}_caster">
        <collision>
          <geometry><sphere radius="${caster_radius}"/></geometry>
        </collision>
        <inertial>
          <mass value="0.05"/>
          <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
        </inertial>
      </link>
      <joint name="${name}_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="${name}_caster"/>
        <origin xyz="${x} 0 ${caster_radius}" rpy="0 0 0"/>
      </joint>
      <gazebo reference="${name}_caster">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        </surface>
      </gazebo>
    </xacro:macro>

    <xacro:caster name="front" x="${caster_x}"/>

    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <max_angular_acceleration>2.0</max_angular_acceleration>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
      </plugin>
    </gazebo>

    <!-- RPLIDAR C1: 360 gr, 360 samples (na hoekcompensatie van de driver) bij 10 Hz, 0,05-12 m (datasheet). -->
    <gazebo reference="laser_frame">
      <sensor name="rplidar_c1" type="gpu_lidar">
        <gz_frame_id>laser_frame</gz_frame_id>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>12.0</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

  </xacro:if>

</robot>
