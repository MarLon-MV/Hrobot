<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hrobot_bringup</name>
  <version>0.1.0</version>
  <description>Launch- en parameterbestanden (slam_toolbox, Nav2, RPLIDAR C1, RViz) voor de teleoperated mapping-robot op basis van de Create 3.</description>
  <maintainer email="dev@example.com">hrobot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>hrobot_description</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <!--
    Driver voor de SLAMTEC RPLIDAR C1. AANNAME: het officiële ROS 2-pakket van Slamtec `sllidar_ros2`
    (https://github.com/Slamtec/sllidar_ros2, node `sllidar_node`). Het is GEEN rosdep-sleutel: het moet in
    de workspace gekloond en vanaf de broncode gebouwd worden; rosdep lost het niet op. Gebruik je een ander
    driver, pas dan de Node in launch/hardware_base.launch.py en deze afhankelijkheid aan.
  -->
  <exec_depend>sllidar_ros2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
